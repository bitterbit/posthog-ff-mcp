# Copy to .env and fill in. All three are required (no defaults).

# Full base URL of your PostHog app host (pick the region that matches your account).
#   EU: https://eu.posthog.com   US: https://us.posthog.com   self-hosted: your instance URL
POSTHOG_HOST=https://eu.posthog.com

# Numeric project id (the number in the app URL /project/<id>).
POSTHOG_PROJECT_ID=13105

# Personal API key scoped to at least "feature_flag:read" for this project.
# Create one at <host>/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=phx_your_key_here
